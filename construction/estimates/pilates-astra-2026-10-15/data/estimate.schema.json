{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pailapilates09-sys.github.io/CAD_Test-Facility/construction/estimates/pilates-astra-2026-10-15/data/estimate.schema.json",
  "title": "Reviewed Pilates Astra estimate v1",
  "type": "object",
  "required": ["schema_version", "document_id", "source", "currency", "summary", "sections", "line_items", "issues", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string"},
    "currency": {"type": ["string", "null"]},
    "estimate_date": {"type": ["string", "null"]},
    "source": {"type": "object", "required": ["file", "sha256", "page_count"], "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "page_count": {"type": "integer", "minimum": 1}}},
    "summary": {"type": "object", "required": ["interior_total", "electrical", "subtotal", "vat_rate", "vat_amount", "grand_total"], "properties": {"interior_total": {"$ref": "#/$defs/decimal"}, "electrical": {"$ref": "#/$defs/decimal"}, "subtotal": {"$ref": "#/$defs/decimal"}, "vat_rate": {"$ref": "#/$defs/decimal"}, "vat_amount": {"$ref": "#/$defs/decimal"}, "grand_total": {"$ref": "#/$defs/decimal"}}},
    "sections": {"type": "array", "items": {"type": "object", "required": ["id", "name", "summary_amount", "summary_amount_minor", "detail_state", "item_count", "pages"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "summary_amount": {"$ref": "#/$defs/decimal"}, "summary_amount_minor": {"type": "integer"}, "detail_state": {"enum": ["detailed", "summary_only"]}, "item_count": {"type": "integer", "minimum": 0}, "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}}}}},
    "line_items": {"type": "array", "items": {"type": "object", "required": ["id", "section_id", "source_sn", "description", "description_raw", "unit_raw", "unit_code", "no", "quantity", "rate", "amount", "amount_minor", "source"], "properties": {"id": {"type": "string"}, "section_id": {"type": "string"}, "source_sn": {"type": "string"}, "description": {"type": "string"}, "description_raw": {"type": "string"}, "unit_raw": {"type": ["string", "null"]}, "unit_code": {"enum": ["ft2", "ft", "each", "point", null]}, "no": {"$ref": "#/$defs/decimal"}, "quantity": {"$ref": "#/$defs/decimal"}, "rate": {"$ref": "#/$defs/decimal"}, "amount": {"$ref": "#/$defs/decimal"}, "amount_minor": {"type": "integer"}, "source": {"type": "object", "required": ["page", "table", "row", "bbox_points", "cells"], "properties": {"page": {"type": "integer", "minimum": 1}, "table": {"type": "integer", "minimum": 1}, "row": {"type": "integer", "minimum": 1}, "bbox_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "cells": {"type": "array"}}}}}},
    "issues": {"type": "array", "items": {"type": "object", "required": ["id", "type", "message"]}},
    "validation": {"type": "object"}
  },
  "$defs": {"decimal": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}}
}
